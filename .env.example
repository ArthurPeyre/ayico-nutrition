# IP LAN du Raspberry Pi (celle utilisee par ton telephone pour le joindre),
# ou son hostname (ex: raspi) si la resolution mDNS/DNS local fonctionne sur
# ton reseau. Verifier avec `ip -brief addr` sur le Pi si l'IP change (baux DHCP).
EXPO_PUBLIC_API_URL=http://raspi:8000

# Host annonce par Metro dans le QR code / l'URL du bundler (au lieu de l'IP
# LAN auto-detectee). Doit etre resolvable par le telephone.
REACT_NATIVE_PACKAGER_HOSTNAME=raspi
